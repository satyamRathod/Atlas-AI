APP_NAME=atlas-api
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Chat Model provider (currently supported: groq)
CHAT_PROVIDER=groq

# Groq (via @langchain/groq) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Embeddings (local, via Transformers.js - no API key required)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Store (Qdrant) - run `docker compose up -d qdrant`
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Redis - not provisioned by docker-compose.yml; point this at any Redis
# instance you already have running (e.g. a shared local instance used by
# other projects). Persists the BM25 lexical corpus built by `knowledge:index`
# so it survives restarts instead of being rebuilt from knowledge/*.md on
# every boot.
REDIS_URL=redis://localhost:6379
BM25_REDIS_KEY=atlas:bm25:corpus
# Persists the parent-document docstore the same way — built by
# `knowledge:index --target=parent-child`, only ever read at boot/query time.
PARENT_DOCSTORE_REDIS_KEY=atlas:parent-docstore

# Knowledge Indexing
# KNOWLEDGE_DIRECTORY defaults to <workspace-root>/knowledge when unset
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=100
INDEX_BATCH_SIZE=100

# Retrieval (Phase 1 — dense baseline)
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.5

# Retrieval (Phase 2 — Advanced RAG)
# Strategy: dense | hybrid | multi_query | self_query | parent_document
RETRIEVAL_STRATEGY=dense
RETRIEVAL_FETCH_K=20

# Hybrid search (dense + BM25 fused via RRF)
RETRIEVAL_HYBRID_DENSE_WEIGHT=0.5
RETRIEVAL_RRF_K=60

# MMR (Maximal Marginal Relevance)
RETRIEVAL_MMR_ENABLED=false
RETRIEVAL_MMR_LAMBDA=0.5
RETRIEVAL_MMR_FETCH_K=20

# Cross-encoder reranking (local, via Transformers.js)
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANK_TOP_N=4

# Context compression (EmbeddingsFilter)
RETRIEVAL_COMPRESSION_ENABLED=false
RETRIEVAL_COMPRESSION_SIMILARITY_THRESHOLD=0.6

# Query expansion
RETRIEVAL_QUERY_EXPANSION_ENABLED=false

# Multi-query retrieval
RETRIEVAL_MULTI_QUERY_COUNT=3

# Parent document retrieval
KNOWLEDGE_PARENT_COLLECTION=knowledge_parent_child
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50

# Memory (Phase 3) — conversation persistence (same Redis instance as above),
# token budgeting, context trimming, rolling summarization
MEMORY_HISTORY_REDIS_PREFIX=atlas:chat:messages
MEMORY_SUMMARY_REDIS_PREFIX=atlas:chat:summary
MEMORY_HISTORY_TTL_SECONDS=604800

# Token budgeting — defaults match openai/gpt-oss-120b's real limits on Groq
MEMORY_MAX_CONTEXT_TOKENS=131072
MEMORY_RESERVED_OUTPUT_TOKENS=8192

# Conversation summarization
MEMORY_RECENT_MESSAGES_KEPT=6
MEMORY_SUMMARY_TRIGGER_TOKENS=2000

# Semantic / vector memory — off by default (adds an LLM call per turn)
MEMORY_SEMANTIC_ENABLED=false
MEMORY_SEMANTIC_COLLECTION=atlas_semantic_memory
MEMORY_SEMANTIC_TOP_K=3
MEMORY_SEMANTIC_SCORE_THRESHOLD=0.5

# Prompt Engineering (Phase 4) — versioned prompt registry (same Redis
# instance as Memory above), dynamic prompt selection, few-shot, structured
# output, and guardrails
PROMPT_REDIS_PREFIX=atlas:prompts:
PROMPT_DEFAULT_TEMPLATE_ID=default

# Guardrails: block | observe
PROMPT_GUARDRAILS_MODE=block
PROMPT_GUARDRAILS_BLOCKED_TERMS=kill someone,make a bomb,how to hack

# Tools (Phase 5) — LangChain tool-calling (bindTools): calculator, weather,
# file search, order lookup, current datetime
TOOLS_MAX_ITERATIONS=3
TOOLS_EXECUTION_TIMEOUT_MS=10000

# Weather tool — Open-Meteo, free and keyless
TOOLS_WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
TOOLS_WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# file_search tool's own top-k for its explicit re-query
TOOLS_FILE_SEARCH_TOP_K=4

# Agents (Phase 6) — a classic text-based ReAct loop (Thought/Action/Action
# Input/Observation, hand-parsed — deliberately not bindTools), reusing
# Phase 5's ToolExecutor for actual tool execution
AGENT_MAX_STEPS=6
AGENT_PLAN_MAX_STEPS=5

# LangGraph (Phase 7) — an explicit StateGraph (agent -> tools loop, native
# bindTools) with a conditional human-approval gate and Redis-backed
# checkpoints for pause/resume (same Redis instance as above)
AGENT_GRAPH_MAX_STEPS=6
AGENT_GRAPH_APPROVAL_TOOLS=order_lookup
GRAPH_CHECKPOINT_TTL_MINUTES=60

# Multi-Agent (Phase 8) — a LangGraph "supervisor" graph: a coordinator
# node dynamically routes between planner/researcher/writer/reviewer
# specialists over shared blackboard state (own Redis-backed checkpointer,
# same Redis instance as above, no human-in-the-loop)
MULTI_AGENT_MAX_ROUNDS=10
MULTI_AGENT_RESEARCHER_MAX_TOOL_CALLS=3
MULTI_AGENT_CHECKPOINT_TTL_MINUTES=60

# Evaluation (Phase 9) — hybrid faithfulness / precision / recall /
# hallucination scoring (opt-in useEvaluation) + Redis-backed benchmark runs
EVALUATION_REDIS_PREFIX=atlas:eval:
EVALUATION_RUN_TTL_MINUTES=1440
EVALUATION_MAX_CLAIMS=12
