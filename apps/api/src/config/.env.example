APP_NAME=atlas-api
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Chat Model provider (currently supported: groq)
CHAT_PROVIDER=groq

# Groq (via @langchain/groq) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Embeddings (local, via Transformers.js - no API key required)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Store (Qdrant) - run `docker compose up -d qdrant`
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Redis - not provisioned by docker-compose.yml; point this at any Redis
# instance you already have running (e.g. a shared local instance used by
# other projects). Persists the BM25 lexical corpus built by `knowledge:index`
# so it survives restarts instead of being rebuilt from knowledge/*.md on
# every boot.
REDIS_URL=redis://localhost:6379
BM25_REDIS_KEY=atlas:bm25:corpus
# Persists the parent-document docstore the same way — built by
# `knowledge:index --target=parent-child`, only ever read at boot/query time.
PARENT_DOCSTORE_REDIS_KEY=atlas:parent-docstore

# Knowledge Indexing
# KNOWLEDGE_DIRECTORY defaults to <workspace-root>/knowledge when unset
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=100
INDEX_BATCH_SIZE=100

# Retrieval (Phase 1 — dense baseline)
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.5

# Retrieval (Phase 2 — Advanced RAG)
# Strategy: dense | hybrid | multi_query | self_query | parent_document
RETRIEVAL_STRATEGY=dense
RETRIEVAL_FETCH_K=20

# Hybrid search (dense + BM25 fused via RRF)
RETRIEVAL_HYBRID_DENSE_WEIGHT=0.5
RETRIEVAL_RRF_K=60

# MMR (Maximal Marginal Relevance)
RETRIEVAL_MMR_ENABLED=false
RETRIEVAL_MMR_LAMBDA=0.5
RETRIEVAL_MMR_FETCH_K=20

# Cross-encoder reranking (local, via Transformers.js)
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_RERANK_TOP_N=4

# Context compression (EmbeddingsFilter)
RETRIEVAL_COMPRESSION_ENABLED=false
RETRIEVAL_COMPRESSION_SIMILARITY_THRESHOLD=0.6

# Query expansion
RETRIEVAL_QUERY_EXPANSION_ENABLED=false

# Multi-query retrieval
RETRIEVAL_MULTI_QUERY_COUNT=3

# Parent document retrieval
KNOWLEDGE_PARENT_COLLECTION=knowledge_parent_child
PARENT_CHUNK_SIZE=2000
PARENT_CHUNK_OVERLAP=200
CHILD_CHUNK_SIZE=400
CHILD_CHUNK_OVERLAP=50
