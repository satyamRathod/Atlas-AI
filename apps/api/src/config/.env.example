APP_NAME=atlas-api
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Chat Model provider (currently supported: groq)
CHAT_PROVIDER=groq

# Groq (via @langchain/groq) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2

# Embeddings (local, via Transformers.js - no API key required)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector Store (Qdrant) - run `docker compose up -d qdrant`
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge

# Knowledge Indexing
# KNOWLEDGE_DIRECTORY defaults to <workspace-root>/knowledge when unset
TEXT_CHUNK_SIZE=500
TEXT_CHUNK_OVERLAP=100
INDEX_BATCH_SIZE=100

# Retrieval
RETRIEVAL_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.5
