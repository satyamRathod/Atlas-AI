{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "files": {
    "includes": ["**", "!dist", "!coverage", "!.turbo", "!docker/qdrant"]
  }
}
