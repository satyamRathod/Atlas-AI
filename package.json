{
  "name": "atlas-ai",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "format": "biome format . --write",
    "lint": "biome check .",
    "check": "biome check . --write",
    "typecheck": "turbo run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0",
    "turbo": "^2.10.6",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,ts,json,md,yml,yaml}": [
      "biome check --write"
    ]
  }
}
